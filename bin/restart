#!/usr/bin/env bash
#
# restart — stop the running instance, then do a full run (install + build +
# start). Use after a code or dependency change. For a no-build restart, use
# `bin/stop && bin/start` instead.
#
# When the app is managed by the fleet, prefer the dashboard's "↻ restart app"
# button; this script is the CLI equivalent for manual / standalone runs.
cd "$(dirname "$0")"
. ./_common.sh

stop_running
exec ./run
